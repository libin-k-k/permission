{
    "name": "libinkk/permission",
    "description": "Production-grade Laravel authorization engine (v1.0) with RBAC, ABAC, multi-tenancy, temporary access, delegation, audit logs, and Vue/React helpers.",
    "keywords": [
        "libinkk",
        "laravel",
        "permission",
        "authorization",
        "rbac",
        "abac",
        "acl",
        "roles",
        "permissions",
        "multi-tenancy",
        "delegation",
        "audit",
        "vue",
        "react"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://www.libinkk.in",
    "authors": [
        {
            "name": "Libin K K",
            "email": "libinkk1999@gmail.com",
            "homepage": "https://www.libinkk.in",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "libinkk1999@gmail.com"
    },
    "require": {
        "php": "^8.1",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Libinkk\\Permission\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Libinkk\\Permission\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Libinkk\\Permission\\Providers\\PermissionServiceProvider"
            ]
        }
    },
    "suggest": {
        "filament/filament": "Required only when using the optional Filament authorization adapter (v0.7).",
        "laravel/telescope": "Optional authorization decision recording in Telescope (v0.8).",
        "barryvdh/laravel-debugbar": "Optional authorization collector for DebugBar (v0.8)."
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
